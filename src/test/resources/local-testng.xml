<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  parallel="tests" → each <test> block runs on its own thread
  thread-count="2" → 2 devices run simultaneously (1 Android + 1 iOS)

  Device configs come from: src/main/resources/config/devices.json

  Parameters:
    - environment : "local" or "remote" (picks from devices.json section)
    - platform    : "android" or "ios"  (picks from that platform's array)
    - deviceIndex : 0-based index into the array (optional, -1 = round-robin)

  To add more devices:
    1. Add device entry in devices.json under local/remote → android/ios
    2. Add another <test> block here with the right deviceIndex
    3. Increase thread-count to match total <test> blocks
-->

<suite name="AI Mobile Automation Suite"
       parallel="tests"
       thread-count="1"
       verbose="1">

    <listeners>
        <listener class-name="com.framework.core.listeners.TestListener"/>
        <listener class-name="com.framework.core.listeners.RetryTransformer"/>
    </listeners>

    <!-- ═══ Android Device 1: Pixel 9 Pro XL (devices.json → local.android[0]) ═══ -->
    <test name="Android Device 1 - Login Tests">
        <parameter name="environment" value="local"/>
        <parameter name="platform" value="android"/>
        <parameter name="deviceIndex" value="0"/>
        <classes>
            <class name="com.framework.tests.ui.LoginTest"/>
        </classes>
    </test>

   <!-- &lt;!&ndash; ═══ iOS Device 1: iPhone 16e (devices.json → local.iOS[0]) ═══ &ndash;&gt;
    <test name="iOS Device 1 - Login Tests">
        <parameter name="environment" value="local"/>
        <parameter name="platform" value="ios"/>
        <parameter name="deviceIndex" value="0"/>
        <classes>
            <class name="com.framework.tests.ui.LoginTest"/>
        </classes>
    </test>-->

</suite>
